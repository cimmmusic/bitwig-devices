// First drawing input: instantaneous abs(L), abs(R), gain, reserved.
uniform float4 audioLow;

half4 main(float2 fragCoord) {
    // The drawing occupies 41 x 35 native grid units.
    float2 p = fragCoord / iResolution.xy * float2(164., 140.);
    float3 color = float3(.055, .068, .080);
    float3 rail = float3(.15, .18, .20);
    float3 meter = float3(.36, .66, .59);
    float3 gain = float3(.74, .54, .30);

    if (p.x >= 12. && p.x < 152.) {
        float position = (p.x - 12.) / 140.;
        if (abs(p.y - 38.) < 6.) color = position < audioLow.x ? meter : rail;
        if (abs(p.y - 66.) < 6.) color = position < audioLow.y ? meter : rail;
        if (abs(p.y - 109.) < 2.) color = position < audioLow.z ? gain : rail;
    }
    return half4(half3(color), 1.);
}
